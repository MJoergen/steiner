## Formal verification of the search in steiner.vhd.
##
## Task naming:  <mode>_<t><k><n>
##
##   cover_124 / bmc_124 / prove_124 - (t,k,n) = (1,2,4): 6 rows, 2 per solution,
##                       3 solutions. The whole search takes about 15 clock
##                       cycles, so the cover and bmc tasks run it to the end.
##
##   prove_237         - (t,k,n) = (2,3,7): the Fano plane, 35 rows, 7 per
##                       solution. Exercises both early-pruning rules, which
##                       (1,2,4) does not.
##
##   prove_348         - (t,k,n) = (3,4,8): 70 rows, 14 per solution. Columns 0
##                       and 1 are together in 3 rows rather than 1, which the
##                       second early-pruning rule must take into account. This
##                       task takes about 50 seconds, the others a few seconds.
##
## memory_map -rom-only turns constant tables into logic. Without it a table
## becomes a ROM, and k-induction treats the contents of a ROM as free state,
## which gives false counterexamples.
##
## Run one task:   sby --yosys "yosys -m ghdl" -f steiner.sby prove_124
## Run everything: sby --yosys "yosys -m ghdl" -f steiner.sby

[tasks]
cover_124  cover  p124
bmc_124    bmc    p124
prove_124  prove  p124
prove_237  prove  p237
prove_348  prove  p348

[options]
cover: mode cover
cover: depth 45
bmc: mode bmc
bmc: depth 50
prove: mode prove
prove: depth 4

[engines]
smtbmc

[script]
p124: ghdl --std=08 -gG_T=1 -gG_K=2 -gG_N=4 steiner_pkg.vhd valid.vhd steiner.vhd steiner.psl -e steiner
p237: ghdl --std=08 -gG_T=2 -gG_K=3 -gG_N=7 steiner_pkg.vhd valid.vhd steiner.vhd steiner.psl -e steiner
p348: ghdl --std=08 -gG_T=3 -gG_K=4 -gG_N=8 steiner_pkg.vhd valid.vhd steiner.vhd steiner.psl -e steiner
prep -top steiner
memory_map -rom-only

[files]
steiner.psl
../src/steiner_pkg.vhd
../src/valid.vhd
../src/steiner.vhd
